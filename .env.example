# ---------------------------------------------------------------------
# Credenciais do banco. TROQUE estes valores antes de usar de verdade.
# Copie este arquivo para ".env" e ajuste: cp .env.example .env
# ---------------------------------------------------------------------
MYSQL_ROOT_PASSWORD=root_secure_password_here
MYSQL_DATABASE=pi2_database
MYSQL_USER=pi2_user
MYSQL_PASSWORD=user_secure_password_here

# true = HTTPS com certificado autoassinado (veja README) | false = só HTTP
USE_HTTPS=false

# Porta HTTP pela qual o sistema é acessado: http://localhost:8192
HTTP_PORT=8192

# phpMyAdmin (opcional, perfil "debug"): http://127.0.0.1:8193
# A porta DEVE ser diferente de HTTP_PORT.
PHPMYADMIN_PORT=8193
