# Copie este arquivo para ".env" e preencha com valores reais.
# O arquivo ".env" (sem ".example") nunca deve ser commitado.

# Banco de dados
MYSQL_ROOT_PASSWORD=troque_esta_senha
MYSQL_DATABASE=projetomi
MYSQL_USER=troque_este_usuario
MYSQL_PASSWORD=troque_esta_senha

# phpMyAdmin
PMA_USER=troque_este_usuario
PMA_PASSWORD=troque_esta_senha

# Portas expostas no host
APP_PORT=8192
PHPMYADMIN_PORT=8168
